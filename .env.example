# Copiar a .env en la raíz para Compose y Prisma. Valores ficticios de desarrollo local.
# No usar estas credenciales públicas en producción. No versionar .env.
POSTGRES_USER=substation
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=substation
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
DATABASE_URL=postgresql://substation:local_development_only@127.0.0.1:5432/substation?schema=public
# La base de tests debe crearse y migrarse por separado; ver README.
TEST_DATABASE_URL=postgresql://substation:local_development_only@127.0.0.1:5432/substation_test?schema=public
# Cola BullMQ del worker. Redis no contiene estado canónico de negocio.
REDIS_URL=redis://127.0.0.1:6379
# Base Redis separada para pruebas de cola.
TEST_REDIS_URL=redis://127.0.0.1:6379/1
